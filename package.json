{
    "name": "gadgetsuae-sync",
    "version": "1.0.0",
    "description": "Amazon Creators API Sync for GadgetsUAE",
    "main": "scripts/amazon-sync.js",
    "scripts": {
        "sync": "node scripts/amazon-sync.js",
        "sync-creators": "node scripts/amazon-creators-sync.js",
        "search": "node scripts/amazon-search.js",
        "discovery": "node scripts/amazon-discovery.js",
        "test": "node --test tests/*.test.js",
        "build:data": "node scripts/build-data.js",
        "build:pages": "node scripts/build-pages.js",
        "build": "npm run build:data && npm run build:pages && node scripts/generate-sitemap.js"
    },
    "dependencies": {
        "amazon-paapi": "^1.0.7",
        "axios": "^1.13.2",
        "dotenv": "^16.6.1"
    }
}
